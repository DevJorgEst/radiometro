# Copia este archivo a .env y rellena los valores
# Genera un secreto seguro con: openssl rand -base64 48

# Obligatorio: el backend NO arranca sin él
JWT_SECRET=

# Opcional (por defecto: 5000)
PORT=5000

# Opcional: orígenes permitidos por CORS, separados por coma
# (por defecto: http://localhost:5173,http://localhost:4173)
# CORS_ORIGINS=http://localhost:5173,https://radiometro.render.com
